{
  "name": "@nia-teams/ai",
  "version": "0.1.0",
  "description": "Composable AI wire protocols.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --strict --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "openai": "4.104.0",
    "undici": "^7.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nia-teams/cloud-agent.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/nia-teams/cloud-agent#readme",
  "bugs": {
    "url": "https://github.com/nia-teams/cloud-agent/issues"
  }
}
